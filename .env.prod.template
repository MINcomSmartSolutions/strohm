# Production Environment Configuration
# Copy this file to .env.prod and fill in the actual production values


SERVER_PORT=3000

# === Database Configuration ===
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_here

# Strohm Database
STROHM_DB_NAME=strohm
STROHM_DB_USER=strohm_admin
STROHM_DB_PASSWORD=secure_strohm_db_password_here
STROHM_DB_PORT=5432

SESSION_SECRET=verysecuresessionsecret

# OIDC Configuration
SERVER_OIDC_SECRET=production_oidc_secret_here
SERVER_OIDC_CLIENT_ID=production_client_id_here
SERVER_OIDC_ISSUER_BASE_URL=https://your-auth-provider.com
SERVER_BASE_URL=https://base_url
SERVER_OIDC_CLIENT_SECRET=production_client_secret_here

# === Odoo Configuration ===
# Odoo Database
ODOO_DB=odoo
ODOO_DB_USER=odoo_admin
ODOO_DB_PASSWORD=secure_odoo_db_password_here
ODOO_ADMIN_PASSWORD=secure_odoo_admin_password_here
ODOO_ADMIN_API_KEY=odoo_admin_api_key_here
ODOO_EXTERNAL_HOST=https://domain.com

# Odoo Performance Settings
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2

# Integration with backend
WEBHOOK_API_KEY=secure_webhook_api_key_here
ODOO_API_SECRET=production_odoo_api_secret_here

# === User/Group IDs (for file permissions) ===
UID=1000
GID=1000

# === Steve
STEVE_HOST=localhost
STEVE_API_KEY_HEADER=STEVE
STEVE_API_KEY=STEVE