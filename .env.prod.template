# Production Environment Configuration
# Copy this file to .env.prod and fill in the actual production values

# === Database Configuration ===
POSTGRES_USER=strohm_user
POSTGRES_PRODUCTION_PASSWORD=secure_postgres_password_here

# Strohm Database
STROHM_DB=strohm_production
STROHM_DB_USER=strohm_api
STROHM_DB_PASSWORD=secure_strohm_db_password_here

# Odoo Database
ODOO_DB=odoo_production
ODOO_DB_USER=odoo_user
ODOO_DB_PRODUCTION_PASSWORD=secure_odoo_db_password_here

# OIDC Configuration
SERVER_PRODUCTION_OIDC_SECRET=production_oidc_secret_here
SERVER_PRODUCTION_OIDC_CLIENT_ID=production_client_id_here
SERVER_PRODUCTION_OIDC_ISSUER_BASE_URL=https://your-auth-provider.com
SERVER_PRODUCTION_BASE_URL=https://base_url
SERVER_PRODUCTION_OIDC_CLIENT_SECRET=production_client_secret_here

# === Odoo Configuration ===
ODOO_ADMIN_PASSWORD=secure_odoo_admin_password_here
ODOO_PRODUCTION_ADMIN_API_KEY=odoo_admin_api_key_here
ODOO_PRODUCTION_API_SECRET=production_odoo_api_secret_here
ODOO_EXTERNAL_HOST=ladenportal.hm.edu

# Odoo Performance Settings
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2

# Integration with backend
WEBHOOK_API_KEY=secure_webhook_api_key_here

# === User/Group IDs (for file permissions) ===
UID=1000
GID=1000